# Plantilla segura de variables de entorno — cymbal-riesgo-api
# Copie a .env para desarrollo local (NUNCA suba archivos .env con valores reales a Git).

CYMBAL_APP_ENV=development
CYMBAL_STORAGE_BACKEND=memory
CYMBAL_GCP_PROJECT_ID=REPLACE_WITH_YOUR_GCP_PROJECT_ID
CYMBAL_FIRESTORE_DATABASE=cymbal-riesgo-db

# Orígenes permitidos en producción (separados por coma)
CYMBAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# En producción SIEMPRE debe ser false para exigir JWT OIDC firmado de Identity Platform
CYMBAL_ALLOW_DEMO_HEADERS=true

# Identidad de Identity Platform / Cloud Scheduler (producción)
CYMBAL_OIDC_ISSUER=https://securetoken.google.com/REPLACE_WITH_YOUR_GCP_PROJECT_ID
CYMBAL_SCHEDULER_SERVICE_ACCOUNT=cymbal-riesgo-scheduler-sa@REPLACE_WITH_YOUR_GCP_PROJECT_ID.iam.gserviceaccount.com

# Nombre del secreto en Google Cloud Secret Manager (NO pegue la API key aquí)
CYMBAL_FX_SECRET_NAME=cymbal-riesgo-fx-api-key
CYMBAL_FX_PROVIDER_MODE=deterministic
